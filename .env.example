# ── Postgres — svc-productos ──────────────────────────────────────────────
PRODUCTOS_DB_NAME=productos_db
PRODUCTOS_DB_USER=productos_user
PRODUCTOS_DB_PASS=productos_pass
PRODUCTOS_DATABASE_URL=postgres://productos_user:productos_pass@localhost:5433/productos_db

# ── Postgres — svc-ordenes ──────────────────────────────────────────────────
ORDENES_DB_NAME=ordenes_db
ORDENES_DB_USER=ordenes_user
ORDENES_DB_PASS=ordenes_pass
ORDENES_DATABASE_URL=postgres://ordenes_user:ordenes_pass@localhost:5434/ordenes_db

# ── Postgres — svc-stock ────────────────────────────────────────────────────
STOCK_DB_NAME=stock_db
STOCK_DB_USER=stock_user
STOCK_DB_PASS=stock_pass
STOCK_DATABASE_URL=postgres://stock_user:stock_pass@localhost:5435/stock_db

# ── Postgres — svc-obs ──────────────────────────────────────────────────────
OBS_DB_NAME=obs_db
OBS_DB_USER=obs_user
OBS_DB_PASS=obs_pass
OBS_DATABASE_URL=postgres://obs_user:obs_pass@localhost:5436/obs_db

# ── Redis (BullMQ) ──────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Servicio: puertos y host ────────────────────────────────────────────────
# Usados por docker-compose y validación @erp/env
PORT_PRODUCTOS=3001
PORT_ORDENES=3002
PORT_STOCK=3003
PORT_OBS=3004
HOST=0.0.0.0
NODE_ENV=development

# ── API Key para endpoints de escritura y rutas /admin ─────────────────────
# Si no se define, la autenticación se omite (solo en development).
# En producción @erp/env exige ADMIN_API_KEY si NODE_ENV=production (ver ADR 005).
ADMIN_API_KEY=dev-admin-key-change-me

# ── JWT (opcional, para RBAC) ────────────────────────────────────────────
# Si se define, requireJwt valida Authorization: Bearer <token>
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Roles: admin | operador | lector
JWT_SECRET=dev-jwt-secret-change-me-min-16-chars

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Valores: fatal | error | warn | info | debug | trace | silent

# ── svc-stock: umbral de stock bajo para generar alertas (default: 10) ─────
STOCK_ALERTA_UMBRAL=10

# ── Tamaño máximo del pool de conexiones PostgreSQL por servicio (default: 10)
DB_POOL_MAX=10

# ── Event bus ───────────────────────────────────────────────────────────────
# Lista de servicios para fan-out (comma-separated). Default: svc-ordenes,svc-stock,svc-productos,svc-obs
# Útil para añadir svc-compras en Fase 9 sin recompilar.
EVENT_BUS_SERVICES=svc-ordenes,svc-stock,svc-productos,svc-obs
OUTBOX_POLL_INTERVAL_MS=500

# ── svc-obs: SLA checker ────────────────────────────────────────────────────
SLA_THRESHOLD_SECONDS=60
SLA_CHECK_INTERVAL_MS=30000

# ── Docker Compose ──────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=inventory-erp
